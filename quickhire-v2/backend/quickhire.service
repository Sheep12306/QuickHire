[Unit]
Description=QuickHire Backend API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/quickhire/quickhire-v2/backend
ExecStart=/opt/quickhire/quickhire-v2/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=-/opt/quickhire/quickhire-v2/backend/.env

[Install]
WantedBy=multi-user.target
